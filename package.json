{
  "name": "dine-backend-monolith",
  "version": "1.0.0",
  "description": "Dine Backend Architecture, System Design & Modular Monolith Delivery Foundation",
  "private": true,
  "scripts": {
    "build": "tsc -p packages/contracts/tsconfig.json && tsc -p apps/api/tsconfig.json",
    "start": "node apps/api/dist/main.js",
    "start:dev": "ts-node apps/api/src/main.ts",
    "test": "node --test tests/unit/*.test.js || python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "ci": "./scripts/ci.sh"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^10.2.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.9",
    "@types/pg": "^8.11.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
