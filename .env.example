# ==============================================================================
# Dine Backend Environment Configuration Template
# All secrets and credentials MUST stay server-side and never be committed to git.
# Startup validation rejects missing required configurations and sanitizes errors.
# ==============================================================================

# Server & Runtime Environment
NODE_ENV=development
PORT=3000
API_PREFIX=/v1
LOG_LEVEL=info

# Database Connectivity (PostgreSQL with btree_gist and PostGIS extensions)
# Migration runner and application connect via standard PostgreSQL URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dine_dev
DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/dine_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_SSL=false

# Identity & Supabase Auth
# JWT verification secret (must be at least 32 characters in production)
SUPABASE_URL=https://mock-project.supabase.co
SUPABASE_ANON_KEY=mock-anon-key-placeholder
SUPABASE_JWT_SECRET=development-mock-jwt-secret-do-not-use-in-production-32chars

# Payment Gateway (Razorpay - Test Mode Only for MVP)
# Production activation requires commercial release gates GATE-001, 002, 003 sign-off
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret_placeholder

# Realtime & Outbox Dispatch
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_MAX_RETRIES=5
OUTBOX_BATCH_SIZE=50

# Request & Idempotency Controls
IDEMPOTENCY_TTL_SECONDS=86400
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
